{
  "manifest_version": 3,
  "name": "IBKR Close Worthiness",
  "version": "1.0",
  "description": "Panel on IBKR pages: is it worth buying back a winning short option before expiry?",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.interactivebrokers.co.uk/*",
        "https://www.interactivebrokers.com/*",
        "https://ndcdyn.interactivebrokers.com/*",
        "https://gdcdyn.interactivebrokers.com/*"
      ],
      "js": ["close-worthiness.js"],
      "run_at": "document_idle"
    }
  ]
}
